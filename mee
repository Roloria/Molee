#!/bin/bash
# Molee - alias entrypoint for the Molee fork.
# Thin wrapper around the upstream-compatible `mole` router so the fork keeps
# merging cleanly while users get a Molee-branded command.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/mole" "$@"
